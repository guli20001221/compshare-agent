# Allowlist: only what the Dockerfile copies enters the build context, so
# neither local state nor unrelated tracked files can leak into the image.
**

!Dockerfile
!.dockerignore
!go.mod
!go.sum

!cmd/
!cmd/**
!internal/
!internal/**

!deploy/
!deploy/conf/
!deploy/migrations/
!deploy/migrations/**
!deploy/ssh_ops_harness/
!deploy/ssh_ops_harness/**
