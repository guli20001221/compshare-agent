# The checkout is ~1.8 GiB (mostly local .claude state).  Use an allowlist so
# neither local data nor unrelated tracked files can enter the build context.
**

!Dockerfile
!Dockerfile.kb-build
!.dockerignore
!go.mod
!go.sum

# Dockerfile.kb-build installs these and runs the interpreter-contract check.
!scripts/
!scripts/rag_v2/
!scripts/rag_v2/requirements.txt
!scripts/rag_v2/check_build_image.py

!cmd/
!cmd/**
!internal/
!internal/**

!deploy/
!deploy/conf/
# config.yaml has not existed since the local/prod split; Dockerfile COPYs
# config.local.yaml and config.prod.yaml, and the build job sed-edits the first
# of them before Kaniko runs. Under this file's own allowlist premise both were
# excluded from the context, so either that COPY has been failing or Kaniko is
# not honouring this file at all -- worth one check either way. Naming what the
# Dockerfile actually reads is correct under both readings.
!deploy/conf/config.local.yaml
!deploy/conf/config.prod.yaml
!deploy/migrations/
!deploy/migrations/**
!deploy/ssh_ops_harness/
!deploy/ssh_ops_harness/**
