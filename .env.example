COMPSHARE_SERVICE_PUBLIC_KEY=
COMPSHARE_SERVICE_PRIVATE_KEY=
COMPSHARE_DEFAULT_ROLE_URN=
LLM_API_KEY=
MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/compshare_agent?parseTime=true&loc=Local&charset=utf8mb4

# Bind address used by `just pack` → `invite.sh` on the server (`ally invite ... -- server --addr $ADDR`).
# Not read by `just run` locally — that path takes --addr from the justfile recipe.
ADDR=10.182.45.17:10100

# Write-operations switch (forwarded by invite.sh to the server process).
# 1 = enable write ops: create/start/stop/reboot/reset-password/resize-disk. This
#     is the deploy-template default by deliberate decision — the production console
#     runs with write ops on, so a packed tarball is write-enabled out of the box.
#     Destructive actions (delete / L2 terminate) stay refused REGARDLESS of this.
# 0 = read-only. Set to 0 for a read-only deployment (e.g. demo/staging).
# NOTE: the Go code default is still off (read-only) — this value only takes effect
# because it is shipped here and forwarded by invite.sh. See CLAUDE.md "Runtime
# feature flags" + the read-only-default note.
COMPSHARE_ENABLE_MUTATING_TOOLS=1

# Context-engineering optimizations (forwarded by invite.sh; Go code default is off).
# Shipped ON in the deploy template by deliberate decision — the production console
# runs with these on, so a packed tarball enables them out of the box. Set any to 0
# (or empty) for a deployment that should run without it. Same model as the write-ops
# switch above: the value takes effect only because it is shipped here and forwarded.
#   USE_SESSION_FACT_CONTEXT     near-term fact cache injected into context (server-only)
#   USE_REACT_RESULT_PROJECTION  compress large read tool results before re-feeding ReAct
#   USE_REACT_HISTORY_COMPACTION summarize old turns once history exceeds the window
USE_SESSION_FACT_CONTEXT=1
USE_REACT_RESULT_PROJECTION=1
USE_REACT_HISTORY_COMPACTION=1

# Planner structured-output mode. PLUMBED but shipped OFF: a live A/B on ds-v4-flash
# (thinking mode) showed json_object does NOT improve the planner schema-valid rate on
# operation commands (schema_valid stayed false with and without it), so it has not
# earned default-on. Set to json_object only after the planner-core eval validates it.
COMPSHARE_INTENT_ROUTER_STRUCTURED_OUTPUT=

# Trace / observability sink (forwarded by invite.sh; Go code default is OFF).
# Shipped ON writing to MySQL by deliberate decision: with these on, every turn
# writes one agent_traces row (outcome/state/retrieval attribution) for the
# production observability dashboard. PREREQUISITE: ops must run the
# deploy/migrations/0002 + 0004 DDL on the MYSQL_DSN database first; the writer
# probes for the promoted columns and degrades to writing only the trace_json blob
# if 0004 has not been applied (so an un-migrated DB still ingests, just without the
# GROUP-BY columns). Set COMPSHARE_TRACE_ENABLED=0 for a deployment without tracing.
#   COMPSHARE_TRACE_ENABLED  1 = write traces; 0 = disable (no writer).
#   COMPSHARE_TRACE_SINK     mysql (agent_traces table) | file (JSONL on disk) |
#                            both (fan-out file+mysql, for cutover comparison).
#   COMPSHARE_TRACE_DIR      JSONL dir for file/both sinks; ignored for mysql.
COMPSHARE_TRACE_ENABLED=1
COMPSHARE_TRACE_SINK=mysql
COMPSHARE_TRACE_DIR=

# Editable create-flow confirmation form (create-flow 表单化; forwarded by invite.sh,
# Go code default OFF). Server half of a double gate: with this on AND the frontend
# opting in per turn (Features:["confirm_form_v1"], already sent by the AIAssistant),
# CreateInstanceWorkflow confirmation frames carry a select-only editable Form
# (GPU / zone / image / charge-type) and accept edits (re-validated, <=3). SAFE if the
# frontend does not opt in — frames stay byte-identical, Overrides rejected. The
# deploy_model saga + CLI confirm are unaffected either way. Set 0 to disable.
COMPSHARE_CONFIRM_FORM=1

# Default answer stack.
# COMPSHARE_DIRECT_DISPATCH_INTENTS defaults to resource,monitor,gpu_specs,stock,pricing,platform_image,custom_image,community_image.
# Set COMPSHARE_DIRECT_DISPATCH_INTENTS=off only for fallback/debugging.
USE_KNOWLEDGE_RETRIEVAL=curated
RAG_RETRIEVAL_MODE=qwen3_rrf
USE_GROUNDED_RENDERER=llm

# Agentic-RAG answer stack (forwarded by invite.sh). Pinned EXPLICITLY rather than
# relying on the binary's cmd-boot default-on, so production behavior never depends on
# an implicit Go default a future change could flip. All default ON; set any to 0 to
# roll back to the prior route.
#   COMPSHARE_AGENTIC_SEARCH_KNOWLEDGE             read-only SearchKnowledge tool (RAG as an agent tool)
#   COMPSHARE_KNOWLEDGE_QA_AGENT_LOOP             knowledge_qa runs in the agent loop (forced SearchKnowledge first hop)
#   COMPSHARE_KNOWLEDGE_QA_DISCIPLINED_SYNTHESIS  final answer written by the tight cited-synthesis prompt (anti-fabrication)
#   COMPSHARE_EXTERNAL_KNOWLEDGE                  merge external tool/ops corpus (vLLM/CUDA/Linux/PyTorch) into the index
COMPSHARE_AGENTIC_SEARCH_KNOWLEDGE=1
COMPSHARE_KNOWLEDGE_QA_AGENT_LOOP=1
COMPSHARE_KNOWLEDGE_QA_DISCIPLINED_SYNTHESIS=1
COMPSHARE_EXTERNAL_KNOWLEDGE=1

# Legacy direct AK/SK; only needed without STS.
COMPSHARE_PUBLIC_KEY=
COMPSHARE_PRIVATE_KEY=
