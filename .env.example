# ─────────────────────────────────────────────────────────────────────────
# Deploy env file — SECRETS + bind address ONLY.
#
# All runtime BEHAVIOR (write ops, agentic RAG, history compaction, screenshot
# OCR, trace sink, intent dispatch, ...) is now configured in agent.yaml under
# agent.features / agent.retrieval / agent.trace / agent.planner — NOT here.
# Copy deploy/conf/agent.yaml.example → agent.yaml and edit it.
#
# For a fully env-free deployment: inline these secret VALUES into agent.yaml
# (loader now accepts inline literals; agent.yaml is gitignored) and set
# agent.http.listen_addr, then you can leave this file empty. The committed
# agent.yaml.example keeps ${ENV_VAR} placeholders, so by default the secrets
# below are still forwarded by invite.sh to resolve those placeholders.
# ─────────────────────────────────────────────────────────────────────────

# STS service credentials (used to mint per-user STS tokens). Required unless
# you use the legacy direct AK/SK path below.
COMPSHARE_SERVICE_PUBLIC_KEY=
COMPSHARE_SERVICE_PRIVATE_KEY=
COMPSHARE_DEFAULT_ROLE_URN=

# LLM API key (ds-v4-flash answerer + intent router + RAG embedding/reranker).
LLM_API_KEY=

# Backing store is PostgreSQL (libpq/URL DSN). The env var name MYSQL_DSN is kept
# for deploy-template stability; the value is a PostgreSQL connection string.
MYSQL_DSN=postgresql://user:pass@127.0.0.1:5432/compshare_agent?sslmode=disable

# Bind address used by invite.sh (ally invite ... -- server --addr $ADDR).
# Alternatively set agent.http.listen_addr in agent.yaml and leave this empty.
ADDR=10.182.45.17:10100

# Legacy direct AK/SK; only needed when STS is not configured (agent.sts empty).
COMPSHARE_PUBLIC_KEY=
COMPSHARE_PRIVATE_KEY=
