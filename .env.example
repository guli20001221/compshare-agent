COMPSHARE_SERVICE_PUBLIC_KEY=
COMPSHARE_SERVICE_PRIVATE_KEY=
COMPSHARE_DEFAULT_ROLE_URN=
LLM_API_KEY=
MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/compshare_agent?parseTime=true&loc=Local&charset=utf8mb4

# Bind address used by `just pack` → `invite.sh` on the server (`ally invite ... -- server --addr $ADDR`).
# Not read by `just run` locally — that path takes --addr from the justfile recipe.
ADDR=10.182.45.17:10100

# Write-operations switch (forwarded by invite.sh to the server process).
# 1 = enable write ops: create/start/stop/reboot/reset-password/resize-disk. This
#     is the deploy-template default by deliberate decision — the production console
#     runs with write ops on, so a packed tarball is write-enabled out of the box.
#     Destructive actions (delete / L2 terminate) stay refused REGARDLESS of this.
# 0 = read-only. Set to 0 for a read-only deployment (e.g. demo/staging).
# NOTE: the Go code default is still off (read-only) — this value only takes effect
# because it is shipped here and forwarded by invite.sh. See CLAUDE.md "Runtime
# feature flags" + the read-only-default note.
COMPSHARE_ENABLE_MUTATING_TOOLS=1

# Default answer stack.
# USE_INTENT_PLANNER_FOR defaults to resource,monitor,gpu_specs,stock,pricing,platform_image,custom_image,community_image.
# Set USE_INTENT_PLANNER_FOR=off only for fallback/debugging.
USE_KNOWLEDGE_RETRIEVAL=curated
RAG_RETRIEVAL_MODE=qwen3_rrf
USE_GROUNDED_RENDERER=llm

# Legacy direct AK/SK; only needed without STS.
COMPSHARE_PUBLIC_KEY=
COMPSHARE_PRIVATE_KEY=
