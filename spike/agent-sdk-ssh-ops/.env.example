# Copy to .env.local (gitignored) and fill in. NEVER commit real secrets.

# --- target instance (the box the agent SSHes into) ---
SSH_HOST=117.50.185.80
SSH_USER=ubuntu
SSH_PORT=22
SSH_PASSWORD=                       # password auth, OR set SSH_KEY_PATH below
# SSH_KEY_PATH=C:\path\to\id_ed25519

# --- third-party model (OpenAI-compatible), driven via the gateway ---
LLM_API_KEY=                        # ModelVerse key (same value as repo-root .env)
LLM_BASE_URL=https://api.modelverse.cn/v1
LLM_MODEL=deepseek-v4-flash

# --- gateway (claude-code-router) ---
# The Agent SDK / Claude Code talk Anthropic /v1/messages to this local gateway,
# which translates to the OpenAI-compatible ModelVerse endpoint above.
ANTHROPIC_BASE_URL=http://127.0.0.1:3456
# any non-empty value; forwarded to the local gateway, never to Anthropic
ANTHROPIC_API_KEY=dummy-unused
